{
  "name": "@zephyrdeng/jev-triage",
  "version": "0.1.0",
  "description": "Triage a GitHub or GitLab backlog with TypeSafe Jev: duplicates, related topics, issue types and dependency order in one HTML report. Ships with an agent skill.",
  "keywords": [
    "jev",
    "typesafe",
    "github",
    "gitlab",
    "issues",
    "backlog",
    "triage",
    "dependency-graph",
    "dedupe",
    "cli",
    "agent-skill"
  ],
  "license": "MIT",
  "author": "ZephyrDeng",
  "homepage": "https://github.com/ZephyrDeng/jev-triage#readme",
  "bugs": {
    "url": "https://github.com/ZephyrDeng/jev-triage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZephyrDeng/jev-triage.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "skills/",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "jev-triage": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
