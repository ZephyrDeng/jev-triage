# TypeSafe (Jev)：未设置时从 TYPESAFE_ENV_FILE（默认 ~/.config/ego-jev/secrets.env）读取
# TYPESAFE_API_KEY=
# TYPESAFE_ENV_FILE=~/.config/ego-jev/secrets.env
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0   # 标定阈值后建议锁定版本

# 可选：--translate 时使用的翻译 LLM（OpenAI 兼容的 /chat/completions 接口）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 可选：合并进请求体 / 请求头的 JSON（opencode 的 x-opencode-session 会自动添加）
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# LLM_HEADERS={}

# 裸 owner/repo 或项目路径使用的主机（URL 中的主机优先），默认 github.com
# FORGE_HOST=github.com
# 平台：github（gh）| gitlab（glab）；未设置时主机名含 github 为 GitHub，其余为 GitLab
# FORGE=
